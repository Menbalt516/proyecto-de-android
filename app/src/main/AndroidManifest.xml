            android:exported="false"
            android:label="Gestión de Sub-Metas" />
        <activity
            android:name=".presentacion.MetaCrearActivity"
            android:exported="false"
            android:label="Crear/Editar Evento" />
        <activity
            android:name=".presentacion.EventoListActivity"
            android:exported="false" />
        <activity
            android:name=".presentacion.CalendarEventosActivity"
            android:exported="false" />
        <activity
            android:name=".presentacion.MetaDetalleActivity"
            android:exported="false" />
        <activity
            android:name=".presentacion.MetasListActivity"
            android:exported="false" />
        <activity
            android:name=".presentacion.MetaSelectorActivity"
            android:exported="false" />
    </application>

</manifest>