            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- ACTIVIDADES DE PERFIL -->
        <activity
            android:name=".presentacion.PerfilActivity"
            android:exported="false" /> <!-- ACTIVIDADES DE METAS -->
        <activity
            android:name=".presentacion.EventoCrearActivity"
            android:exported="false"
            android:label="Detalle de Meta" />
        <activity
