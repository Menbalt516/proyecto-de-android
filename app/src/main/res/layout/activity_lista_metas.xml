<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Botón para crear una nueva meta -->
    <Button
        android:id="@+id/btnNuevaMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nueva Meta"
        android:padding="12dp"
        android:layout_marginBottom="10dp" />

    <!-- Botón para seleccionar meta existente -->
    <Button
        android:id="@+id/btnSeleccionarMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seleccionar Meta"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <!-- Lista de metas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMetas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
